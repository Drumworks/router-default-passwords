            "type": "string"
          },
          {
            "name": "source_archive_url",
            "type": "string"
          },
          {
            "name": "confidence",
            "type": "string"
          },
          {
            "name": "last_verified",
            "type": "date"
          },
          {
            "name": "ssid_url",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "routers-json",
      "path": "routers.json",
      "format": "json",
      "mediatype": "application/json"
    },
    {
      "name": "compliance",
      "path": "compliance.json",
      "format": "json",
      "mediatype": "application/json"
    }
  ]
